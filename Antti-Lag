local function applyOptimizations()
	pcall(function()
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
		Lighting.FogStart = 9e9
		Lighting.Brightness = 1
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
		Lighting.ExposureCompensation = 0

		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") then
				v.Enabled = false
			end
		end
	end)

	pcall(function()
		if Terrain then
			Terrain.WaterWaveSize = 0
			Terrain.WaterWaveSpeed = 0
			Terrain.WaterReflectance = 0
			Terrain.WaterTransparency = 1
		end
	end)

	pcall(function()
		if typeof(settings) == "function" then
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end
	end)
end

local function simplifyPart(obj: Instance)
	if not BoostActive then return end
	if obj:IsA("BasePart") then
		obj.Material = Enum.Material.Plastic
		obj.Reflectance = 0
		obj.CastShadow = false
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		obj.Transparency = 1
	elseif obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then
		obj.Enabled = false
	elseif obj:IsA("Explosion") or obj:IsA("Beam") or obj:IsA("Highlight") then
		pcall(obj.Destroy, obj)
	end
end

-- Scan workspace
for _, v in ipairs(Workspace:GetDescendants()) do
	simplifyPart(v)
end

Workspace.DescendantAdded:Connect(simplifyPart)
applyOptimizations()

local function toggleBoost()
	BoostActive = not BoostActive
	if BoostActive then
		applyOptimizations()
		for _, v in ipairs(Workspace:GetDescendants()) do
			simplifyPart(v)
		end
	end
	updateUI()
end

