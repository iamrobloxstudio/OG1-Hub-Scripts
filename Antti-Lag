-- CONFIG
_G.FollowOffset = Vector3.new(0, 0.6, 0) -- ðŸ‘ˆ BAJADO para seguir el torso
_G.AvoidCollisionOffset = Vector3.new(0, 0, 0.5)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

local bringTargets = {}
local following = false

---------------------------------------------------------
-- NUEVOS CACHES (ANTI-LAG)
---------------------------------------------------------
local cachedToolParts = {}
local cachedTorso = {}

---------------------------------------------------------
-- FUNCION CLAVE (ORIGINAL - NO TOCADA)
---------------------------------------------------------
local function getToolPart(tool)
	if tool:FindFirstChild("Handle") and tool.Handle:IsA("BasePart") then
		return tool.Handle
	end

	if tool.PrimaryPart and tool.PrimaryPart:IsA("BasePart") then
		return tool.PrimaryPart
	end

	for _, v in ipairs(tool:GetDescendants()) do
		if v:IsA("BasePart") then
			return v
		end
	end

	return nil
end

---------------------------------------------------------
-- NUEVA FUNCION: CACHEAR TOOLS (NO REEMPLAZA)
---------------------------------------------------------
local function updateToolCache()
	table.clear(cachedToolParts)
	if not LocalPlayer.Character then return end

	for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
		if tool:IsA("Tool") then
			local part = getToolPart(tool)
			if part then
				cachedToolParts[#cachedToolParts + 1] = part
			end
		end
	end
end

---------------------------------------------------------
-- NUEVA FUNCION: CACHEAR TORSO OBJETIVO (FORZADO A TORSO)
---------------------------------------------------------
local function getCachedTorso(char)
	if cachedTorso[char] and cachedTorso[char].Parent then
		return cachedTorso[char]
	end

	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	cachedTorso[char] = torso
	return torso
end

